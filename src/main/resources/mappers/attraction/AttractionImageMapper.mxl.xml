<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.triplog.attraction.mapper.attraction.AttractionImageMapper">

    <insert id="insertImage"
            parameterType="com.ssafy.triplog.attraction.dto.AttractionImageDto"
            useGeneratedKeys="true"
            keyProperty="no">
        INSERT INTO attraction_image (image_url,
                                      review_image_order,
                                      attraction_no,
                                      attraction_review_no)
        VALUES (#{imageUrl},
                #{reviewImageOrder},
                #{attractionNo},
                #{attractionReviewNo})
    </insert>

</mapper>
