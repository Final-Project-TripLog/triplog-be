<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.triplog.attraction.repository.mapper.attraction.AttractionMapper">

    <insert id="insertAttraction" parameterType="com.ssafy.triplog.attraction.dto.AttractionDto" useGeneratedKeys="true"
            keyProperty="no">
        INSERT INTO attractions (title,
                                 overview,
                                 map_level,
                                 latitude,
                                 longitude,
                                 tel,
                                 address,
                                 address_detail,
                                 homepage,
                                 api_id,
                                 content_id,
                                 thumbnail,
                                 rating,
                                 gugun_no,
                                 sido_no,
                                 attraction_type_no)
        VALUES (#{title},
                #{overview},
                #{mapLevel},
                #{latitude},
                #{longitude},
                #{tel},
                #{address},
                #{addressDetail},
                #{homepage},
                #{apiId},
                #{contentId},
                #{thumbnail},
                #{rating},
                #{gugunNo},
                #{sidoNo},
                #{attractionTypeNo})
    </insert>
</mapper>