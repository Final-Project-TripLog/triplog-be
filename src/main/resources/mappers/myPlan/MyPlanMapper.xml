    <!-- ✅ 올바른 매핑: DB 컬럼 → 실제 DTO 필드 -->
    <resultMap id="MyPlanDtoResultMap" type="com.ssafy.triplog.myplan.dto.MyPlanDto">
        <!-- PK 매핑 -->
        <id property="no" column="no"/>

        <!-- 일반 필드 매핑 -->
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="userNo" column="user_no"/>

        <!-- 🔑 핵심: DB 컬럼명 → 실제 DTO 필드명 매핑 -->
        <result property="startTime" column="start_day"/>      <!-- DB: start_day → DTO: startTime -->
        <result property="endTime" column="end_day"/>          <!-- DB: end_day → DTO: endTime -->
        <result property="updateTime" column="updated_at"/>    <!-- DB: updated_at → DTO: updateTime -->
        <result property="totalMember" column="total_member"/>
    </resultMap>

    <!-- 사용자별 여행 계획 목록 조회 -->
    <select id="selectMyPlansByUser" resultMap="MyPlanDtoResultMap">
        SELECT
        no,
        title,
        description,
        user_no,
        start_day,     <!-- ✅ snake_case -->
        end_day,       <!-- ✅ snake_case -->
        updated_at,
        total_member   <!-- ✅ snake_case -->
        FROM my_plan
        WHERE user_no = #{userNo}
        ORDER BY updated_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <resultMap id="MyDailyPlanDtoResultMap" type="com.ssafy.triplog.myplan.dto.MyDailyPlanDto">
        <!-- PK 매핑 -->
        <id property="no" column="no"/>

        <!-- 일정 관련 필드 -->
        <result property="visitedDate" column="visited_date"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="moveTime" column="move_time"/>
        <result property="memo" column="memo"/>

        <!-- 관광지 정보 (DB에 직접 저장되어 있음) -->
        <result property="attractionTitle" column="attraction_title"/>
        <result property="attractionThumbnail" column="attraction_thumbnail"/>
        <result property="attractionLatitude" column="attraction_latitude"/>
        <result property="attractionLongitude" column="attraction_longitude"/>
        <result property="attractionRating" column="attraction_rating"/>

        <!-- 외래키 -->
        <result property="attractionNo" column="attraction_no"/>
        <result property="myPlanNo" column="my_plan_no"/>
    </resultMap>

    <!-- ✅ 여행 계획의 일일 계획 목록 조회 (JOIN 없음!) -->
    <select id="selectDailyPlansByPlanNo" resultMap="MyDailyPlanDtoResultMap">
        SELECT
            no,
            visited_date,
            start_time,
            end_time,
            move_time,
            attraction_title,
            attraction_thumbnail,
            attraction_latitude,
            attraction_longitude,
            attraction_rating,
            memo,
            attraction_no,
            my_plan_no
        FROM my_daily_plan
        WHERE my_plan_no = #{planNo}
        ORDER BY visited_date ASC, start_time ASC  -- ✅ 날짜 먼저, 시간 순서
    </select>

