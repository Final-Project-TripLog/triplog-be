    <!-- 사용자별 여행 계획 목록 조회 -->
    <select id="selectMyPlansByUser" resultMap="MyPlanDtoResultMap">
        SELECT
        no,
        title,
        description,
        user_no,
        start_day,     <!-- ✅ snake_case -->
        end_day,       <!-- ✅ snake_case -->
        updated_at,
        total_member   <!-- ✅ snake_case -->
        FROM my_plan
        WHERE user_no = #{userNo}
        ORDER BY updated_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
